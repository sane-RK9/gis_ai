# Geospatial Data APIs
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
VITE_ESRI_API_KEY=your_esri_api_key_here

# Satellite Imagery APIs
VITE_PLANET_API_KEY=your_planet_api_key_here
VITE_SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
VITE_SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret

# Open Data APIs
VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
VITE_NOMINATIM_API_URL=https://nominatim.openstreetmap.org
VITE_BHOONIDHI_API_KEY=your_bhoonidhi_api_key_here

# Processing APIs
VITE_GDAL_API_URL=http://localhost:8080/gdal
VITE_QGIS_SERVER_URL=http://localhost:8081/qgis
VITE_GRASS_GIS_API_URL=http://localhost:8082/grass

# Database Configuration
VITE_POSTGIS_CONNECTION_STRING=postgresql://user:password@localhost:5432/gisdb

# Authentication
VITE_AUTH0_DOMAIN=your_auth0_domain
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=your_auth0_audience

# Analytics and Monitoring
VITE_SENTRY_DSN=your_sentry_dsn
VITE_ANALYTICS_ID=your_analytics_id