FROM ubuntu:22.04

# Set non-interactive frontend to avoid prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# --- Layer 1: Install ALL system dependencies in a single layer ---
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    # For adding the PPA
    software-properties-common \
    gnupg \
    # For building Python packages
    build-essential \
    python3.10 \
    python3-pip \
    python3-dev \
    # For manual tool installation
    curl \
    unzip \
    && add-apt-repository -y ppa:ubuntugis/ubuntugis-unstable \
    && apt-get update \
    # Install modern geospatial libraries from the PPA
    && apt-get install -y --no-install-recommends \
    gdal-bin \
    libgdal-dev \
    libspatialindex-dev \
    libgeos-dev \
    libproj-dev \
    libsqlite3-mod-spatialite \
    spatialite-bin \
    # Clean up APT caches to reduce image size
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Layer 2: Install WhiteboxTools manually ---
COPY resources/whitebox_tools /usr/local/bin/whitebox_tools
# Make it executable
RUN chmod +x /usr/local/bin/whitebox_tools

# --- Layer 3: Copy and install Python dependencies with a longer timeout ---
WORKDIR /app
COPY requirements.txt .
RUN pip3 install \
    --no-cache-dir \
    --no-binary gdal \
    --timeout 600 \
    -r requirements.txt

# --- Layer 4: Set up workspace ---
RUN mkdir -p /data_workspace
VOLUME /data_workspace

# Final command to keep container running
CMD ["sleep", "infinity"]